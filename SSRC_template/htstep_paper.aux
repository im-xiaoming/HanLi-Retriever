\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Các head chính của mô hình. \emph  {Event head} cho biết mỗi thời điểm có nằm trong một bước hay không. \emph  {Boundary head} cho biết bước đó bắt đầu và kết thúc ở đâu, kèm một điểm chất lượng dùng để xếp hạng các đoạn. \emph  {Point-wise head} và \emph  {segment-wise head} (màu tím) tạo multimodal embedding cho mỗi thời điểm và cho cả đoạn, được distill từ OmniRetriever. Chữ đỏ in nghiêng là loss của mỗi đầu ra.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:heads}{{4}{4}{Các head chính của mô hình. \emph {Event head} cho biết mỗi thời điểm có nằm trong một bước hay không. \emph {Boundary head} cho biết bước đó bắt đầu và kết thúc ở đâu, kèm một điểm chất lượng dùng để xếp hạng các đoạn. \emph {Point-wise head} và \emph {segment-wise head} (màu tím) tạo multimodal embedding cho mỗi thời điểm và cho cả đoạn, được distill từ OmniRetriever. Chữ đỏ in nghiêng là loss của mỗi đầu ra}{figure.4}{}}
